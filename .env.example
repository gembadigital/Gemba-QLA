# ANTHROPIC_API_KEY: Claude API anahtarı (console.anthropic.com → API Keys).
# Sohbet asistanı ve sektör maliyet yapısı web araştırması için kullanılır.
# Tanımlı değilse uygulama çalışmaya devam eder: dahili sektör tablosu ve hazır yanıtlar gösterilir.
# Vercel'de: Project → Settings → Environment Variables. Gerçek anahtarı asla repoya koymayın.
ANTHROPIC_API_KEY="sk-ant-..."

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
